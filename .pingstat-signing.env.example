# Copy to .pingstat-signing.env (gitignored) and adjust. Sourced by build-release.sh / release.sh.
#
# Team ID on your Developer ID Application certificate (not a personal Apple Development team
# unless they are the same membership).
DEVELOPMENT_TEAM=34S6MQZHXC

# Optional: staple after notarization (requires notary credentials below).
# PINGSTAT_NOTARIZE=1
# NOTARY_KEYCHAIN_PROFILE=PingStat-notary

# Create profile once (password via secure prompt — omit --password):
#   xcrun notarytool store-credentials "PingStat-notary" \
#     --apple-id "you@example.com" --team-id "34S6MQZHXC"
